<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiProject.AdminShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiProject"
    Title="MauiProject">

    <TabBar>
        <ShellContent
            Icon="home.png"
        Title="Store"
        ContentTemplate="{DataTemplate local:Views.StorePage}"
        Route="StorePage" />
        <ShellContent
            Icon="profile.png"
        Title="Profile"
        ContentTemplate="{DataTemplate local:Views.ProfilePage}"
        Route="ProfilePage" />
    </TabBar>
</Shell>