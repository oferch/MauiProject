<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ViewModels="clr-namespace:MauiProject.ViewModels"
             x:Class="MauiProject.Views.RegisterPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="{AppThemeBinding Dark={StaticResource Key=PageBackgroundDark}, Light={StaticResource Key=PageBackgroundLight}}"
             Shell.NavBarIsVisible="False"
             Title="RegisterPage">

    <ContentPage.BindingContext>
        <ViewModels:RegisterPageViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Green" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Grid ColumnDefinitions="48, *, 48" Padding="16, 12">
                <ImageButton Source="arrow_back.png" 
                             HeightRequest="24" 
                             HorizontalOptions="Start"
                             BackgroundColor="Transparent"/>
                <Label Grid.Column="1" 
                       Text="Registration" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Dark=White, Light={StaticResource Key=TextPrimary}}"/>
            </Grid>

            <Border Margin="16, 8"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    HeightRequest="260">
                <Grid>
                    <Image Source="registration_hero_bg.png" Aspect="AspectFill"/>
                </Grid>
            </Border>

            <VerticalStackLayout Padding="20, 24, 20, 16" Spacing="4">
                <Label Text="Create Account" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Dark=White, Light={StaticResource Key=TextPrimary}}"/>
                <Label Text="Please fill in the details below to get started." 
                       FontSize="16" 
                       TextColor="{StaticResource Key=TextSecondary}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Padding="20, 0" Spacing="20">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Full Name" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Dark=White, Light={StaticResource Key=TextPrimary}}"/>
                    <Border Stroke="{AppThemeBinding Dark={StaticResource Key=BorderDark}, Light={StaticResource Key=BorderLight}}"
                            StrokeShape="RoundRectangle 8" 
                            Padding="12, 0">
                        <Entry x:Name="FullNameEntry"
                               Text="{Binding FullName}"
                               Placeholder="Enter your full name, first and last" 
                               Style="{StaticResource Key=LoginEntryStyle}"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Username" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Dark=White, Light={StaticResource Key=TextPrimary}}"/>
                    <Border Stroke="{AppThemeBinding Dark={StaticResource Key=BorderDark}, Light={StaticResource Key=BorderLight}}"
                            StrokeShape="RoundRectangle 8" 
                            Padding="12, 0">
                        <Entry x:Name="UsernameEntry"
                               Text="{Binding UserName}"
                               Placeholder="Must not start with a digit, or contain spaces E.g. johndoe123" 
                               Style="{StaticResource Key=LoginEntryStyle}"/>
                    </Border>
                    <Label x:Name="UsernameErrorLabel"
                           Text=""
                           FontSize="12"
                           TextColor="#EF4444"
                           Padding="4,0,0,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Email" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Dark=White, Light={StaticResource Key=TextPrimary}}"/>
                    <Border Stroke="{AppThemeBinding Dark={StaticResource Key=BorderDark}, Light={StaticResource Key=BorderLight}}"
                            StrokeShape="RoundRectangle 8" 
                            Padding="12, 0">
                        <Entry x:Name="EmailEntry"
                               Placeholder="hello@example.com" 
                               Keyboard="Email"
                               Text="{Binding Email}"
                               Style="{StaticResource Key=LoginEntryStyle}">
                            <Entry.Behaviors>
                                <toolkit:EmailValidationBehavior 
                                InvalidStyle="{StaticResource InvalidEntryStyle}"
                                ValidStyle="{StaticResource ValidEntryStyle}"
                                Flags="ValidateOnValueChanged" />
                            </Entry.Behaviors>
                        </Entry>

                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Phone Number" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Dark=White, Light={StaticResource Key=TextPrimary}}"/>
                    <Border Stroke="{AppThemeBinding Dark={StaticResource Key=BorderDark}, Light={StaticResource Key=BorderLight}}"
                            StrokeShape="RoundRectangle 8" 
                            Padding="12, 0">
                        <Entry x:Name="PhoneEntry"
                               Placeholder="+1 (555) 000-0000" 
                               Keyboard="Telephone"
                               Text="{Binding Phone}"
                               Style="{StaticResource Key=LoginEntryStyle}"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Password" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Dark=White, Light={StaticResource Key=TextPrimary}}"/>
                    <Border Stroke="{AppThemeBinding Dark={StaticResource Key=BorderDark}, Light={StaticResource Key=BorderLight}}"
                            StrokeShape="RoundRectangle 8" 
                            Padding="12, 0">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="Min. 8 characters, One Upper case letter and one digit" 
                                   IsPassword="{Binding IsPasswordNotVisible}" 
                                   Text="{Binding Password}"
                                   Style="{StaticResource Key=LoginEntryStyle}"/>
                            <ImageButton Grid.Column="1" 
                                         x:Name="TogglePasswordButton"
                                         Source="visibility_off.png" 
                                         HeightRequest="20" 
                                         BackgroundColor="Transparent"
                                         Clicked="OnTogglePasswordClicked"/>
                        </Grid>
                    </Border>
                    <Label x:Name="PasswordErrorLabel"
                           Text=""
                           FontSize="12"
                           TextColor="#EF4444"
                           Padding="4,0,0,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Date of Birth" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Dark=White, Light={StaticResource Key=TextPrimary}}"/>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                        <Border Stroke="{AppThemeBinding Dark={StaticResource Key=BorderDark}, Light={StaticResource Key=BorderLight}}"
                                StrokeShape="RoundRectangle 8" 
                                Padding="12, 0"
                                HeightRequest="56">
                            <DatePicker x:Name="DobPicker"
                                        DateSelected="OnDateOfBirthSelected"
                                        Format="MM/dd/yyyy"
                                        Date="{Binding DateOfBirth}"
                                        TextColor="{AppThemeBinding Dark=White, Light={StaticResource Key=TextPrimary}}"
                                        VerticalOptions="Center"/>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#103985EF"
                                Stroke="{AppThemeBinding Dark={StaticResource Key=PrimaryBlue}, Light={StaticResource Key=PrimaryBlue}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                HeightRequest="56"
                                WidthRequest="60">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <Label Text="AGE" 
                                       FontSize="10" 
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Key=PrimaryBlue}" 
                                       HorizontalOptions="Center"/>
                                <Label x:Name="AgeLabel"
                                       Text="{Binding Age}" 
                                       FontSize="20" 
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Key=PrimaryBlue}" 
                                       HorizontalOptions="Center"
                                       Margin="0,-4,0,0"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Label x:Name="AgeErrorLabel"
                          Text=""
                          FontSize="12"
                          TextColor="#EF4444"
                          Padding="4,0,0,0"/>
                </VerticalStackLayout>

                <Button Text="Register" 
                        Style="{StaticResource Key=PrimaryButtonStyle}"
                        Margin="0, 16, 0, 0"
                        IsEnabled="{Binding IsReady}"
                        Clicked="OnRegisterClicked"/>

                <HorizontalStackLayout HorizontalOptions="Center" Padding="0, 20, 0, 60">
                    <Label Text="Already have an account?" FontSize="14" TextColor="{StaticResource Key=TextSecondary}"/>
                    <Button Text="Sign In" 
                            FontAttributes="Bold" 
                            TextColor="{StaticResource Key=PrimaryBlue}" 
                            BackgroundColor="Transparent" 
                            Padding="5, 0"
                            FontSize="14"
                            Clicked="OnSignInClicked"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>    